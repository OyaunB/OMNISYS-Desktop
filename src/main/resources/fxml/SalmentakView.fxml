<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.omnisys.desktop.controller.SalmentakController"
            prefWidth="1400"
            prefHeight="850"
            style="-fx-background-color: #071426;">

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="20"
              style="-fx-background-color: #10243D; -fx-padding: 20 30;">

            <Button fx:id="backButton"
                    text="← Aginte-panela"
                    style="-fx-background-color: #263D56;
               -fx-text-fill: #FF5555;
               -fx-font-weight: bold;
               -fx-background-radius: 6;
               -fx-padding: 10 22 10 22;
               -fx-cursor: hand;"/>

            <Label text="OMNISYS  |  SALMENTAK"
                   style="-fx-text-fill: white;
                          -fx-font-size: 20px;
                          -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="22"
              style="-fx-padding: 35;">

            <Label text="Salmenta-eskaerak"
                   style="-fx-text-fill: white;
                          -fx-font-size: 27px;
                          -fx-font-weight: bold;"/>

            <Label text="Hilabete honetako salmenta-eskaera baieztatuak"
                   style="-fx-text-fill: #9BAFC5;
                          -fx-font-size: 14px;"/>

            <HBox alignment="CENTER_LEFT" spacing="15">

                <Label text="HILABETEA:"
                       style="-fx-text-fill: white;
                  -fx-font-weight: bold;"/>

                <ComboBox fx:id="monthComboBox"
                          prefWidth="180"
                          promptText="Aukeratu hilabetea"
                          style="-fx-background-color: #263D56;
       -fx-mark-color: #FF5555;
       -fx-text-fill: white;"/>

                <Label text="URTEA:"
                       style="-fx-text-fill: white;
                  -fx-font-weight: bold;"/>

                <ComboBox fx:id="yearComboBox"
                          prefWidth="120"
                          promptText="Aukeratu urtea"
                          style="-fx-background-color: #263D56;
       -fx-mark-color: #FF5555;
       -fx-text-fill: white;"/>

            </HBox>

            <TableView fx:id="salesTable"
                       VBox.vgrow="ALWAYS"
                       style="-fx-background-color: #10243D;">

                <columns>
                    <TableColumn fx:id="orderColumn"
                                 text="ESKAERA"
                                 prefWidth="180"/>

                    <TableColumn fx:id="customerColumn"
                                 text="BEZEROA"
                                 prefWidth="300"/>

                    <TableColumn fx:id="dateColumn"
                                 text="DATA"
                                 prefWidth="220"/>

                    <TableColumn fx:id="amountColumn"
                                 text="ZENBATEKOA ($)"
                                 prefWidth="200"/>

                    <TableColumn fx:id="stateColumn"
                                 text="EGOERA"
                                 prefWidth="180"/>
                </columns>

            </TableView>

        </VBox>
    </center>

</BorderPane>
