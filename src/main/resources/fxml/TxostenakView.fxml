<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import java.net.URL?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.omnisys.desktop.controller.TxostenakController"
            prefWidth="1400"
            prefHeight="850">

    <stylesheets>
        <URL value="@../css/dashboard.css"/>
    </stylesheets>

    <!-- GOIKO GOIBURUA -->
    <top>
        <BorderPane style="-fx-background-color: #10243D;
                           -fx-padding: 18 25 18 25;">

            <left>
                <Label text="OMNISYS  |  Txostenak"
                       style="-fx-text-fill: white;
                              -fx-font-size: 19px;
                              -fx-font-weight: bold;"/>
            </left>

            <right>
                <Button fx:id="backButton"
                        text="← Aginte-panela"
                        style="-fx-background-color: #263D56;
                               -fx-text-fill: #FF5555;
                               -fx-font-weight: bold;
                               -fx-background-radius: 6;
                               -fx-padding: 10 22 10 22;"/>
            </right>

        </BorderPane>
    </top>

    <!-- EDUKI NAGUSIA -->
    <center>
        <VBox spacing="25"
              style="-fx-padding: 35;">

            <Label text="TXOSTENEN KUDEAKETA"
                   style="-fx-text-fill: white;
                          -fx-font-size: 27px;
                          -fx-font-weight: bold;"/>

            <Label text="Enpresako datuak kontsultatu eta txostenak deskargatu"
                   style="-fx-text-fill: #9BAFC5;
                          -fx-font-size: 14px;"/>

            <VBox spacing="22"
                  style="-fx-background-color: #10243D;
                         -fx-background-radius: 12;
                         -fx-padding: 25;">

                <Label text="TXOSTENAK"
                       style="-fx-text-fill: #20DDF5;
                              -fx-font-size: 18px;
                              -fx-font-weight: bold;"/>

                <Label text="Aukeratu deskargatu nahi duzun txostena:"
                       style="-fx-text-fill: white;
                              -fx-font-size: 14px;"/>

                <!-- LEHENENGO ILARA -->
                <HBox spacing="20">

                    <Button fx:id="salesButton"
                            text="SALMENTAK&#10;CSV deskargatu"
                            prefWidth="280"
                            prefHeight="85"
                            style="-fx-background-color: #263D56;
                                   -fx-text-fill: #20DDF5;
                                   -fx-font-size: 15px;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 8;
                                   -fx-border-color: #20DDF5;
                                   -fx-border-radius: 8;
                                   -fx-padding: 12;"/>

                    <Button fx:id="purchasesButton"
                            text="EROSKETAK&#10;CSV deskargatu"
                            prefWidth="280"
                            prefHeight="85"
                            style="-fx-background-color: #263D56;
                                   -fx-text-fill: #20DDF5;
                                   -fx-font-size: 15px;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 8;
                                   -fx-border-color: #20DDF5;
                                   -fx-border-radius: 8;
                                   -fx-padding: 12;"/>

                </HBox>

                <!-- BIGARREN ILARA -->
                <HBox spacing="20">

                    <Button fx:id="inventoryButton"
                            text="INBENTARIOA&#10;CSV deskargatu"
                            prefWidth="280"
                            prefHeight="85"
                            style="-fx-background-color: #263D56;
                                   -fx-text-fill: #FF9800;
                                   -fx-font-size: 15px;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 8;
                                   -fx-border-color: #FF9800;
                                   -fx-border-radius: 8;
                                   -fx-padding: 12;"/>

                    <Button fx:id="financialButton"
                            text="FINANTZAK&#10;CSV deskargatu"
                            prefWidth="280"
                            prefHeight="85"
                            style="-fx-background-color: #263D56;
                                   -fx-text-fill: #00C853;
                                   -fx-font-size: 15px;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 8;
                                   -fx-border-color: #00C853;
                                   -fx-border-radius: 8;
                                   -fx-padding: 12;"/>

                </HBox>

                <Label text="CSV fitxategiak Excel edo antzeko kalkulu-orrietan ireki daitezke."
                       style="-fx-text-fill: #9BAFC5;
                              -fx-font-size: 12px;"/>

            </VBox>

        </VBox>
    </center>

</BorderPane>
