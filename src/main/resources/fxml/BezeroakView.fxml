<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.omnisys.desktop.controller.BezeroakController"
            prefWidth="1400"
            prefHeight="850"
            style="-fx-background-color: #071426;">

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="20"
              style="-fx-background-color: #10243D; -fx-padding: 20 30;">

            <Button fx:id="backButton"
                    text="← Aginte-panela"
                    style="-fx-background-color: #263D56;
               -fx-text-fill: #FF5555;
               -fx-font-weight: bold;
               -fx-background-radius: 6;
               -fx-padding: 10 22 10 22;
               -fx-cursor: hand;"/>

            <Label text="OMNISYS  |  BEZEROAK"
                   style="-fx-text-fill: white;
                          -fx-font-size: 20px;
                          -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="22"
              style="-fx-padding: 35;">

            <Label text="Bezeroen zerrenda"
                   style="-fx-text-fill: white;
                          -fx-font-size: 27px;
                          -fx-font-weight: bold;"/>

            <Label text="Odoo 19 sisteman erregistratutako bezeroak"
                   style="-fx-text-fill: #9BAFC5;
                          -fx-font-size: 14px;"/>

            <TableView fx:id="customersTable"
                       VBox.vgrow="ALWAYS"
                       style="-fx-background-color: #10243D;">

                <columns>
                    <TableColumn fx:id="idColumn"
                                 text="ID"
                                 prefWidth="150"/>

                    <TableColumn fx:id="nameColumn"
                                 text="BEZEROAREN IZENA"
                                 prefWidth="600"/>
                </columns>

            </TableView>

        </VBox>
    </center>

</BorderPane>
