<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import java.net.URL?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.ColumnConstraints?>


<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.omnisys.desktop.controller.DashboardController"
            prefWidth="1400"
            prefHeight="850">

    <stylesheets>
        <URL value="@../css/dashboard.css"/>
    </stylesheets>

    <left>
        <VBox prefWidth="250"
              spacing="18"
              alignment="TOP_CENTER"
              style="-fx-background-color: #10243D;
             -fx-padding: 25;">

            <ImageView fitWidth="180"
                       preserveRatio="true">
                <image>
                    <Image url="@../images/omnisys_full_white.png"/>
                </image>
            </ImageView>

            <Label text="KUDEAKETA SISTEMA"
                   style="-fx-text-fill: #20DDF5;
                          -fx-font-size: 11px;
                          -fx-font-weight: bold;"/>

            <VBox spacing="10">
                <Label text="OMNISYS  |  Hasiera"
                       style="-fx-text-fill: white;
              -fx-font-size: 19px;
              -fx-font-weight: bold;"/>

<!--                <Button fx:id="dashboardButton"-->
<!--                        text="⌂  Aginte-panela"-->
<!--                        styleClass="nav-button"/>-->

                <Button fx:id="productsButton"
                        text="📦  Produktuak"
                        styleClass="nav-button"/>

                <Button fx:id="salesButton"
                        text="🛒  Salmentak"
                        styleClass="nav-button"/>

                <Button fx:id="purchasesButton"
                        text="🛍  Erosketak"
                        styleClass="nav-button"/>

                <Button fx:id="customersButton"
                        text="👥  Bezeroak"
                        styleClass="nav-button"/>

                <Button fx:id="financesButton"
                        text="📊  Finantzak"
                        styleClass="nav-button"/>

                <Button fx:id="reportsButton"
                        text="📄  Txostenak"
                        styleClass="nav-button"/>

                <Button fx:id="inventoryButton"
                        text="🏬  Inbentarioa"
                        styleClass="nav-button"/>

                <Button fx:id="usersButton"
                        text="🧑  ERABILTZAILEAK"
                        styleClass="nav-button"/>

            </VBox>

        </VBox>
    </left>

    <top>
        <BorderPane style="-fx-background-color: #10243D;
                   -fx-padding: 18 25 18 25;">

            <left>
                <Label text="OMNISYS  |  Aginte-panela"
                       style="-fx-text-fill: white;
                              -fx-font-size: 19px;
                              -fx-font-weight: bold;"/>
            </left>

            <right>
                <HBox alignment="CENTER_RIGHT" spacing="20">
                    <Label fx:id="currentUserLabel"
                           text="Erabiltzailea"
                           style="-fx-text-fill: #20DDF5;
              -fx-font-size: 13px;"/>

                    <Button fx:id="logoutButton"
                            text="Saioa itxi"
                            style="-fx-background-color: #D64545;
               -fx-text-fill: white;
               -fx-font-weight: bold;
               -fx-background-radius: 6;"/>
                </HBox>
            </right>

        </BorderPane>
    </top>



    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    style="-fx-background: #071629;
                       -fx-background-color: #071629;
                       -fx-border-color: transparent;">

            <content>
                <VBox spacing="25"
                      fillWidth="true"
                      style="-fx-padding: 30;">

                    <VBox spacing="8">
<!--                        <Label text="Ongi etorri OMNISYSera"-->
<!--                               style="-fx-text-fill: white;-->
<!--                                  -fx-font-size: 27px;-->
<!--                                  -fx-font-weight: bold;"/>-->

                        <Label text="Enpresaren egoera orokorra"
                               style="-fx-text-fill: #9BAFC5;
                                  -fx-font-size: 14px;"/>
                    </VBox>

                    <!-- SEI ESTATISTIKA TXARTEL -->
                    <GridPane hgap="20" vgap="20">

                        <columnConstraints>
                            <ColumnConstraints percentWidth="33.333"/>
                            <ColumnConstraints percentWidth="33.333"/>
                            <ColumnConstraints percentWidth="33.334"/>
                        </columnConstraints>

                        <!-- SALMENTAK -->
                        <VBox GridPane.columnIndex="0"
                              GridPane.rowIndex="0"
                              GridPane.hgrow="ALWAYS"
                              minHeight="115"
                              spacing="12"
                              style="-fx-background-color: #10243D;
                                 -fx-background-radius: 12;
                                 -fx-padding: 22;">

                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label text="SALMENTAK"
                                       style="-fx-text-fill: #20DDF5;
                                          -fx-font-size: 13px;"/>
                                <Label fx:id="monthlySalesMonthLabel"
                                       style="-fx-text-fill: #FF9F43;
                                          -fx-font-size: 13px;
                                          -fx-font-weight: bold;"/>
                            </HBox>

                            <Label fx:id="monthlySalesLabel"
                                   text="Kargatzen..."
                                   style="-fx-text-fill: white;
                                      -fx-font-size: 25px;
                                      -fx-font-weight: bold;"/>
                        </VBox>

                        <!-- EROSKETAK -->
                        <VBox GridPane.columnIndex="1"
                              GridPane.rowIndex="0"
                              GridPane.hgrow="ALWAYS"
                              minHeight="115"
                              spacing="12"
                              style="-fx-background-color: #10243D;
                                 -fx-background-radius: 12;
                                 -fx-padding: 22;">

                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label text="EROSKETAK"
                                       style="-fx-text-fill: #20DDF5;
                                          -fx-font-size: 13px;"/>
                                <Label fx:id="monthlyPurchasesMonthLabel"
                                       style="-fx-text-fill: #FF9F43;
                                          -fx-font-size: 13px;
                                          -fx-font-weight: bold;"/>
                            </HBox>

                            <Label fx:id="monthlyPurchasesLabel"
                                   text="Kargatzen..."
                                   style="-fx-text-fill: white;
                                      -fx-font-size: 25px;
                                      -fx-font-weight: bold;"/>
                        </VBox>

                        <!-- BEZEROAK -->
                        <VBox GridPane.columnIndex="2"
                              GridPane.rowIndex="0"
                              GridPane.hgrow="ALWAYS"
                              minHeight="115"
                              spacing="12"
                              style="-fx-background-color: #10243D;
                                 -fx-background-radius: 12;
                                 -fx-padding: 22;">

                            <Label text="BEZEROAK"
                                   style="-fx-text-fill: #20DDF5;
                                      -fx-font-size: 13px;"/>

                            <Label fx:id="totalCustomersLabel"
                                   text="Kargatzen..."
                                   style="-fx-text-fill: white;
                                      -fx-font-size: 25px;
                                      -fx-font-weight: bold;"/>
                        </VBox>

                        <!-- PRODUKTUAK -->
                        <VBox GridPane.columnIndex="0"
                              GridPane.rowIndex="1"
                              GridPane.hgrow="ALWAYS"
                              minHeight="115"
                              spacing="12"
                              style="-fx-background-color: #10243D;
                                 -fx-background-radius: 12;
                                 -fx-padding: 22;">

                            <Label text="PRODUKTUAK"
                                   style="-fx-text-fill: #20DDF5;
                                      -fx-font-size: 13px;"/>

                            <Label fx:id="totalProductsLabel"
                                   text="Kargatzen..."
                                   style="-fx-text-fill: white;
                                      -fx-font-size: 25px;
                                      -fx-font-weight: bold;"/>
                        </VBox>

                        <!-- IRABAZIAK -->
                        <VBox GridPane.columnIndex="1"
                              GridPane.rowIndex="1"
                              GridPane.hgrow="ALWAYS"
                              minHeight="115"
                              spacing="12"
                              style="-fx-background-color: #10243D;
                                 -fx-background-radius: 12;
                                 -fx-padding: 22;">

                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label text="IRABAZIAK"
                                       style="-fx-text-fill: #20DDF5;
                                          -fx-font-size: 13px;"/>
                                <Label fx:id="profitMonthLabel"
                                       style="-fx-text-fill: #FF9F43;
                                          -fx-font-size: 13px;
                                          -fx-font-weight: bold;"/>
                            </HBox>

                            <Label fx:id="profitValueLabel"
                                   text="Kargatzen..."
                                   style="-fx-text-fill: white;
                                      -fx-font-size: 25px;
                                      -fx-font-weight: bold;"/>
                        </VBox>

                        <!-- STOCKA -->
                        <VBox GridPane.columnIndex="2"
                              GridPane.rowIndex="1"
                              GridPane.hgrow="ALWAYS"
                              minHeight="115"
                              spacing="12"
                              style="-fx-background-color: #10243D;
                                 -fx-background-radius: 12;
                                 -fx-padding: 22;">

                            <Label text="STOCKA"
                                   style="-fx-text-fill: #20DDF5;
                                      -fx-font-size: 13px;"/>

                            <Label fx:id="totalStockLabel"
                                   text="Kargatzen..."
                                   style="-fx-text-fill: white;
                                      -fx-font-size: 25px;
                                      -fx-font-weight: bold;"/>
                        </VBox>

                    </GridPane>

                    <!-- GRAFIKAK BEHEAN -->
                    <HBox spacing="20" alignment="TOP_CENTER">

                        <!-- SALMENTAK ETA EROSKETAK -->
                        <VBox spacing="12"
                              HBox.hgrow="ALWAYS"
                              minWidth="0"
                              style="-fx-background-color: #10243D;
                                 -fx-background-radius: 12;
                                 -fx-padding: 20;">

                            <Label text="SALMENTAK ETA EROSKETAK"
                                   style="-fx-text-fill: #20DDF5;
                                      -fx-font-size: 16px;
                                      -fx-font-weight: bold;"/>

                            <BarChart fx:id="salesPurchasesChart"
                                      animated="false"
                                      legendVisible="true"
                                      prefHeight="340"
                                      minHeight="300"
                                      VBox.vgrow="ALWAYS">

                                <xAxis>
                                    <CategoryAxis side="BOTTOM"
                                                  style="-fx-tick-label-fill: #20DDF5;
                                                     -fx-tick-label-font-size: 13px;
                                                     -fx-font-weight: bold;"/>
                                </xAxis>

                                <yAxis>
                                    <NumberAxis side="LEFT"
                                                forceZeroInRange="true"/>
                                </yAxis>
                            </BarChart>
                        </VBox>

                        <!-- SALMENTEN BILAKAERA -->
                        <VBox spacing="12"
                              HBox.hgrow="ALWAYS"
                              minWidth="0"
                              style="-fx-background-color: #10243D;
                                 -fx-background-radius: 12;
                                 -fx-padding: 20;">

                            <Label text="SALMENTEN BILAKAERA"
                                   style="-fx-text-fill: #20DDF5;
                                      -fx-font-size: 16px;
                                      -fx-font-weight: bold;"/>

                            <LineChart fx:id="salesEvolutionChart"
                                       animated="false"
                                       legendVisible="false"
                                       createSymbols="true"
                                       prefHeight="340"
                                       minHeight="300"
                                       VBox.vgrow="ALWAYS">

                                <xAxis>
                                    <CategoryAxis side="BOTTOM"
                                                  style="-fx-tick-label-fill: #20DDF5;
                                                     -fx-tick-label-font-size: 13px;
                                                     -fx-font-weight: bold;"/>
                                </xAxis>

                                <yAxis>
                                    <NumberAxis side="LEFT"
                                                forceZeroInRange="true"/>
                                </yAxis>
                            </LineChart>
                        </VBox>

                    </HBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
