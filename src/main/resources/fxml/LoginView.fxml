<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.omnisys.desktop.controller.LoginController"
           prefWidth="1000" prefHeight="650"
           style="-fx-background-color: #071426;">

    <VBox alignment="CENTER"
          spacing="18"
          maxWidth="420"
          style="-fx-background-color: #10243D;
                 -fx-background-radius: 18;
                 -fx-padding: 40;">

        <ImageView fitWidth="250"
                   preserveRatio="true">
            <image>
                <Image url="@../images/omnisys_full_white.png"/>
            </image>
        </ImageView>

        <Label text="DESKTOP MANAGEMENT SYSTEM"
               style="-fx-text-fill: #20DDF5;
                      -fx-font-size: 12px;
                      -fx-font-weight: bold;"/>

        <Label text="Ongi etorri"
               style="-fx-text-fill: white;
                      -fx-font-size: 28px;
                      -fx-font-weight: bold;"/>

        <Label text="Sartu datuak OMNISYS - era sartzeko"
               style="-fx-text-fill: #A9BED3;
                      -fx-font-size: 13px;"/>

        <VBox spacing="7">
            <Label text="Erabiltzailea"
                   style="-fx-text-fill: white;"/>
            <TextField fx:id="usernameField"
                       promptText="Sartu erabiltzailea"
                       prefHeight="42"/>
        </VBox>

        <VBox spacing="7">
            <Label text="Pasahitza"
                   style="-fx-text-fill: white;"/>
            <PasswordField fx:id="passwordField"
                           promptText="Sartu zure pasahitza"
                           prefHeight="42"/>
        </VBox>

        <Label fx:id="messageLabel"
               text=""
               wrapText="true"
               style="-fx-text-fill: #FF7070;
                      -fx-font-size: 12px;"/>

        <Button fx:id="loginButton"
                text="SARTU"
                maxWidth="Infinity"
                prefHeight="46"
                style="-fx-background-color: #00CFEF;
                       -fx-text-fill: #071426;
                       -fx-font-weight: bold;
                       -fx-font-size: 14px;
                       -fx-background-radius: 8;"/>

        <Label text="OMNISYS © 2026"
               style="-fx-text-fill: #607D98;
                      -fx-font-size: 11px;"/>

    </VBox>

</StackPane>
