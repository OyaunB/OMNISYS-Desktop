<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.layout.Region?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.omnisys.desktop.controller.ErabiltzaileakController"
            prefWidth="1400"
            prefHeight="850"
            style="-fx-background-color: #071426;">

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="22"
              style="-fx-background-color: #10243D; -fx-padding: 20 32 20 32;">

            <Button fx:id="backButton"
                    text="← Aginte-panela"
                    style="-fx-background-color: #263D56;
               -fx-text-fill: #FF5555;
               -fx-font-weight: bold;
               -fx-background-radius: 6;
               -fx-padding: 10 22 10 22;
               -fx-cursor: hand;"/>

            <Label text="OMNISYS  |  ERABILTZAILEAK"
                   style="-fx-text-fill: white;
                      -fx-font-size: 21px;
                      -fx-font-weight: bold;"/>

        </HBox>
    </top>

    <center>

        <VBox spacing="22"
              style="-fx-padding: 35;">

            <Label text="Erabiltzaileen kudeaketa"
                   style="-fx-text-fill: white;
                          -fx-font-size: 27px;
                          -fx-font-weight: bold;"/>

            <Label text="Aplikazioaren erabiltzaileak sortu eta kudeatu"
                   style="-fx-text-fill: #9BAFC5;
                          -fx-font-size: 14px;"/>

            <HBox spacing="15">
                <Button fx:id="newUserButton"
                        text="+ Erabiltzaile berria"
                        style="-fx-background-color: #00CDEB;
               -fx-text-fill: #071426;
               -fx-font-weight: bold;
               -fx-background-radius: 6;"/>
            </HBox>

            <!-- ERABILTZAILE BERRIA SORTZEKO FORMULARIOA -->
            <VBox fx:id="newUserForm"
                  spacing="15"
                  visible="false"
                  managed="false"
                  style="-fx-background-color: #10243D;
             -fx-background-radius: 12;
             -fx-padding: 22;">


                <Label text="ERABILTZAILE BERRIA"
                       style="-fx-text-fill: #20DDF5;
                  -fx-font-size: 16px;
                  -fx-font-weight: bold;"/>

                <Label text="Erabiltzaile-izena"
                       style="-fx-text-fill: white;
              -fx-font-size: 13px;"/>

                <TextField fx:id="newUsernameField"
                           promptText="Sartu erabiltzaile-izena"
                           prefWidth="350"/>

                <Label text="Pasahitza"
                       style="-fx-text-fill: white;
              -fx-font-size: 13px;"/>

                <PasswordField fx:id="newPasswordField"
                               promptText="Sartu pasahitza"
                               prefWidth="350"/>

                <Label text="Erabiltzaile mota"
                       style="-fx-text-fill: white;
              -fx-font-size: 13px;"/>

                <ComboBox fx:id="newUserRoleComboBox"
                          promptText="Aukeratu erabiltzaile mota"
                          prefWidth="350"/>
                    <HBox spacing="12">

                        <Button fx:id="saveUserButton"
                                text="ERABILTZAILEA SORTU"
                                style="-fx-background-color: #00CDEB;
                       -fx-text-fill: #071426;
                       -fx-font-weight: bold;
                       -fx-background-radius: 6;"/>

                        <Button fx:id="cancelUserButton"
                                text="UTZI"
                                style="-fx-background-color: #263D56;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;
                       -fx-background-radius: 6;"/>

                    </HBox>

                <Label fx:id="formMessageLabel"
                       text=""
                       style="-fx-text-fill: #20DDF5;
                              -fx-font-size: 12px;
                              -fx-font-weight: bold;"/>

            </VBox>

            <Label text="ERABILTZAILEEN ZERRENDA"
                   style="-fx-text-fill: #20DDF5;
                          -fx-font-size: 14px;
                          -fx-font-weight: bold;"/>
            <TableView fx:id="usersTable"
                       prefHeight="350">

                <columns>

                    <TableColumn fx:id="idColumn"
                                 text="ID"
                                 prefWidth="60"/>

                    <TableColumn fx:id="usernameColumn"
                                 text="ERABILTZAILEA"
                                 prefWidth="200"/>

                    <TableColumn fx:id="roleColumn"
                                 text="ROLA"
                                 prefWidth="150"/>

                    <TableColumn fx:id="createdAtColumn"
                                 text="SORTZE DATA"
                                 prefWidth="180"/>
                    <TableColumn fx:id="actionsColumn"
                                 text="EKINTZAK"
                                 prefWidth="150"/>
                    <TableColumn fx:id="roleActionsColumn"
                                 text="ROLA ALDATU"
                                 prefWidth="170"/>

                </columns>

            </TableView>

        </VBox>
    </center>

</BorderPane>
